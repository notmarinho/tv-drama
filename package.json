    "expo": "^54.0.20",
    "expo-build-properties": "~1.0.9",
    "expo-font": "~14.0.9",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.13",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "expo-video": "~3.0.15",
    "expo-video-thumbnails": "~10.0.8",
